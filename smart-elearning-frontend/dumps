    passed.value = response.data.passed
    assessmentSubmitted.value = true
    
  } catch (err) {
    error.value = err.response?.data?.message || 'Failed to submit assessment'
  } finally {
    loading.value = false
  }
}

const proceedToCourses = () => {
  router.push('/courses')
}

onMounted(() => {
  loadAssessment()
})
</script> */}