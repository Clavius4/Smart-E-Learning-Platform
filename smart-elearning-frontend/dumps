      selectedAnswers.value[q._id] = undefined
    })
    
  } catch (err) {
    error.value = err.response?.data?.message || 'Failed to load assessment'
  } finally {
    loading.value = false
  }
}

const selectAnswer = (questionId, optionIndex) => {
  selectedAnswers.value[questionId] = optionIndex
}

const nextQuestion = () => {
  if (!isLastQuestion.value) {
    currentQuestionIndex.value++
  }
}

const prevQuestion = () => {
  if (currentQuestionIndex.value > 0) {
    currentQuestionIndex.value--
  }
}

