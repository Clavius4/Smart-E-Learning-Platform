# Application Environment
NODE_ENV=development # or 'production' for live deployment
VUE_APP_ENV=development # Frontend environment
VUE_APP_NAME=e-Smart Learning
VUE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://206.189.112.134:5000/api
API_BASE_URL=http://206.189.112.134:5000/api

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=localhost
SERVER_SESSION_SECRET=your_session_secret_key_here # Should be complex and kept secret
SERVER_JWT_SECRET=your_jwt_secret_key_here # Should be complex and kept secret
SERVER_JWT_EXPIRES_IN=24h # JWT token expiration time

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esmartlearning
DB_USER=esmart_user
DB_PASSWORD=your_secure_db_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false # Set to true in production with proper certificates

# Email Service (for password reset, notifications)
EMAIL_SERVICE=SendGrid # or 'SMTP'
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=your_email_username
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@esmartlearning.com
EMAIL_SECURE=false # Set to true for port 465

# Third-Party API Keys
VUE_APP_GOOGLE_ANALYTICS_ID=UA-XXXXX-Y # Optional
VUE_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key # For forms
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Feature Flags
VUE_APP_MAINTENANCE_MODE=false
VUE_APP_REGISTRATION_OPEN=true
