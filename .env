# ==============================
# 🌍 General App Configuration
# ==============================
PORT=5000                    # Port your server will run on
NODE_ENV=development         # Set to 'development' or 'production'

# ==============================
# 🛢 Database Configuration
# ==============================
DB_HOST=localhost            # Database host (if using a remote DB, replace with the host URL)
DB_PORT=5432                 # Database port (5432 for PostgreSQL, 27017 for MongoDB)
DB_USER=my_db_user           # Database username
DB_PASS=my_db_password       # Database password
DB_NAME=my_database_name     # Database name

# ==============================
# 🔑 Authentication & Security
# ==============================
JWT_SECRET=my_super_secret_jwt_key    # JWT secret key for authentication
JWT_EXPIRES_IN=7d                     # Token expiration time (e.g., 7d = 7 days)
SESSION_SECRET=my_session_secret_key   # Secret key for session handling

